  "item": [
    {
      "id": "e269c592-5c12-42de-9581-f9c2e665e303",
      "name": "Machine Translation (MT)",
      "description": {
        "content": "The Smartling platform offers state-of-the-art [Machine Translation capabilities](https://www.smartling.com/software/neural-machine-translation-hub/) through its synchronous account-level Machine Translation API. This API enables seamless translation of content without the need for it to be processed through Smartling workflows. The API offers access to all <a href=\"https://help.smartling.com/hc/en-us/articles/46030485398171\" target=\"_blank\" rel=\"noopener\"> Profiles</a>, including the highly efficient MT Auto Select feature, providing unparalleled flexibility and control over your translation needs.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "7d9708cf-580c-46f6-99dc-f38a143bbe88",
          "name": "Machine Translation (MT) using a preconfigured MT or LLM Profile",
          "request": {
            "name": "Machine Translation (MT) using a preconfigured MT or LLM Profile",
            "description": {
              "content": "Machine Translation (MT) using a preconfigured MT or LLM Profile. Input and output text format is HTML.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "mt-router-api",
                "v2",
                "accounts",
                ":accountUid",
                "smartling-mt"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "accountUid",
                  "description": "(Required) A unique account identifier. This can be found in the Smartling Dashboard under Account Settings > API."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceLocaleId\": \"<string>\",\n  \"targetLocaleId\": \"<string>\",\n  \"items\": [\n    {\n      \"key\": \"<string>\",\n      \"sourceText\": \"<string>\"\n    },\n    {\n      \"key\": \"<string>\",\n      \"sourceText\": \"<string>\"\n    }\n  ],\n  \"profileUid\": \"<string>\"\n}",
              "options": {
                "raw": {
