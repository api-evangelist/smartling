        {
          "info": {
            "name": "Search For User Assignments",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.smartling.com/people-api/v3/accounts/:accountUid/users/:userUid/workflow-steps",
            "params": [
              {
                "name": "accountUid",
